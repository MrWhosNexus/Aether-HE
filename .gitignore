# Python
__pycache__/
*.py[cod]
# Local virtualenv (rebuild from requirements)
venv-web/
venv/
# OS / editor
.DS_Store
*.swp
# PyInstaller build outputs (rebuild via build_installer.bat)
/build/
/dist/
*.spec.bak
# Vendored binary installers (re-downloaded by build_installer.bat)
vendor/*.exe
vendor/*.msi
# Flatpak build outputs (rebuild via flatpak/io.github.mrwhosnexus.AetherHE.yml)
flatpak/build-dir/
flatpak/repo/
flatpak/.flatpak-builder/
.flatpak-builder/
flatpak/*.flatpak

# Secrets — never commit. Local key lives here; CI uses a GitHub Actions secret.
.env
.env.*
!.env.example

# Generated / scratch / logs (not shipped)
graphify-out/
.superpowers/
*.log
service/service.log

# Vendor-authored reference material (driver code, string tables, configs).
# Kept locally for protocol research; never published (copyright: see NOTICE.md).
/research/

# macOS: local virtualenv, and the icon CI generates with tools/make_icns.sh
.venv-mac/
ui/assets/logo.icns
