# AetherHE board-draft bot — local secrets template.
# Copy this file to `.env` and fill in your key. `.env` is git-ignored and must
# NEVER be committed. The key is read only by tools/ (minimax_client.py); it is
# never exposed to the app UI / webview frontend.
#
#   cp .env.example .env      # then edit .env and paste your key
#
# For CI (GitHub Actions) do NOT use this file — set a repo secret instead:
#   gh secret set MINIMAX_API_KEY

MINIMAX_API_KEY=
# Optional overrides (defaults are fine for MiniMax):
# MINIMAX_BASE_URL=https://api.minimax.io/v1
# MINIMAX_MODEL=MiniMax-M3
